# =========================================================
# NETFLIX ACCESS APP - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# =========================================================

# Flask Secret Key (Generate a random 32-character hex key)
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Admin Authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password_immediately
# Optional pre-hashed password (recommended for production):
# ADMIN_PASSWORD_HASH=scrypt:32768:8:1$...
# Server-to-server API Key:
ADMIN_API_KEY=your_secure_s2s_api_key_here

# Security & Reverse Proxy Allowlist
TRUSTED_PROXIES=127.0.0.1,::1
SESSION_COOKIE_SECURE=False

# Feature Flags
AUTO_APPROVAL_ENABLED=False

# Supabase Cloud Database (PostgreSQL)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_or_anon_key
POSTGRES_URL=

# Mistral AI (For Support Chatbot & OCR Vision Verification)
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest

# Rotating Proxy Configuration (SOCKS5 / HTTP)
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=
WEBSHARE_HOST=p.webshare.io
WEBSHARE_PORT=9999

# Telegram Bot Alerts (Optional - For Low-Stock & Warranty notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server Port
PORT=5000
