# =========================================================
# NETFLIX ACCESS APP - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# =========================================================

# Flask Secret Key (Generate a random 32-character hex key)
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Admin Authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password_immediately

# Supabase Cloud Database (Optional - App uses local SQLite if left empty)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_or_anon_key
POSTGRES_URL=

# Mistral AI (Optional - For Support Chatbot & OCR Translation)
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest

# Rotating Proxy Configuration (SOCKS5 / HTTP)
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=
WEBSHARE_HOST=p.webshare.io
WEBSHARE_PORT=80

# Telegram Bot Alerts (Optional - For Low-Stock & Warranty notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server Port
PORT=5000
